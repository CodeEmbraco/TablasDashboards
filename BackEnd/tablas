create table tbl_Empresa(
    idEmpresa int primary key IDENTITY(1,1), 
    NombreEmpresa varchar(50),
    Pais varchar(25),
    Direccion varchar(255)
);

create table tbl_Usuario(
    idUser int primary key IDENTITY(1,1), 
    Nombre varchar (50),
    Apellidos varchar (50),
    UsuarioNidec varchar (25),
    Pass varchar (25),
    Correo varchar (50),
    idDpto int,
    idEmpresa int,
    tipoUsuarioCOMAT varchar (25),
    administrativo int, /* cambiar a tipoUser */
    StatusUser int,
    createDate datetime DEFAULT GETDATE()
);/* los tipos de usuario -1 SuperAdmin, 1 administrativo, 2 auditor/supervisor/etc, 3 operador*/

create table tbl_Linea(
    idLinea int primary key IDENTITY(1,1),
    idEmpresa int,
    Nombre varchar(50),
    Foreign key (idEmpresa) References Empresa(idEmpresa)
);

create table tbl_subEstacion(
    idSubEstacion int primary key IDENTITY(1,1),
    idLinea int,
    nombreSubEstacion varchar (15),
    Foreign key (idLinea) References tbl_Linea(idLinea)
);

create table tbl_Departamento(
    idDpto int primary key IDENTITY(1,1), 
    NombreDpto varchar(50),
    idEmpresa int,
    Foreign key (idEmpresa) References Empresa(idEmpresa)
);
-- IT, Legal, Calidad, Produccion, Logistica, Embarques, RH, Mtto, EHS, Finanzas, Administrativo

create table tbl_CTQs(
    idCTQ int primary key IDENTITY(1,1),
    idSubEstacion int,
    nombreCTQ varchar(20),
    limiteXhora int,
    createDate datetime DEFAULT GETDATE(),
    lastUpdateBy int,
    lastUpdate datetime,
    Activo INT DEFAULT 1,
    Foreign key (idSubEstacion) References tbl_subEstacion(idSubEstacion)
)

CREATE TABLE tbl_Checklist_Template (
    idTemplate INT PRIMARY KEY IDENTITY(1,1),
    idCTQ INT NOT NULL,                    
    Activo INT DEFAULT 1,                
    CreatedDate DATETIME DEFAULT GETDATE(),
    LastUpdate DATETIME,
    LastUpdateBy INT,                         
    FOREIGN KEY (idCTQ) REFERENCES CTQs(idCTQ)
);

CREATE TABLE tbl_Checklist_Items (
    idItem INT PRIMARY KEY IDENTITY(1,1),
    idTemplate INT NOT NULL,               
    ChkType int,  -- 1 Proceso, 2 Producto              
    ControlParameter VARCHAR(255),         
    Spec VARCHAR(100),                    
    MeasuringDevice VARCHAR(100),          
    DocumentRef VARCHAR(50),
    OrderIndex INT,               
    FOREIGN KEY (idTemplate) REFERENCES tbl_Checklist_Template(idTemplate)
);

CREATE TABLE tbl_Checklist_Execution (
    idExecution INT PRIMARY KEY IDENTITY(1,1),
    idTemplate INT NOT NULL,               
    idUser INT NOT NULL,                   
    ExecutionDate DATETIME DEFAULT GETDATE(),
    ImmediateAction NVARCHAR(MAX),
    Why1 NVARCHAR(500),
    Why2 NVARCHAR(500),
    Why3 NVARCHAR(500),
    CorrectiveAction NVARCHAR(MAX),
    
    FOREIGN KEY (idTemplate) REFERENCES tbl_Checklist_Template(idTemplate)
);

CREATE TABLE tbl_Checklist_Answers (
    idAnswer INT PRIMARY KEY IDENTITY(1,1),
    idExecution INT NOT NULL,              
    idItem INT NOT NULL,                   
    IsChecked BIT NOT NULL,                 
    FOREIGN KEY (idExecution) REFERENCES tbl_Checklist_Execution(idExecution),
    FOREIGN KEY (idItem) REFERENCES tbl_Checklist_Items(idItem)
);

Create Table tbl_Enlace(
    idEnlace int primary key IDENTITY(1,1),
    Descripcion varchar(50),
    Link varchar(250),
    idDpto int,
    Foreign key (idDpto) References Departamento(idDpto) 
)

Create Table tbl_AccesoEspecial(
    idTabla int primary key IDENTITY(1,1),
    idUser int, 
    idEnlace int,
    Foreign key (idUser) References Usuario(idUser),
    Foreign key (idEnlace) References tbl_Enlace(idEnlace)
);  

CREATE TABLE tbl_CTQ_Clic(
    idClic INT PRIMARY KEY IDENTITY(1,1),
    idCTQ INT NOT NULL,
    fechaHora DATETIME DEFAULT GETDATE(),
    idUser INT NOT NULL,
    excedioLimite BIT DEFAULT 0,  
    checkListLlenado BIT DEFAULT 0, 
    idExecution INT NULL,     
    FOREIGN KEY (idCTQ) REFERENCES tbl_CTQs(idCTQ)
);

